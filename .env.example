# Copy to .env (repo root) for local builds. Same Firebase project as the staff
# schedule (schedule.chsnz.co.nz), so everyone signs in once for every app.
# These end up in the public JavaScript anyway (Firebase web config is not
# secret); in GitHub they live in Settings -> Secrets and variables -> Actions.
#
# Leave them empty to run `npm run dev` with a pretend "Dev User" instead of
# real Microsoft sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_AZURE_TENANT_ID=

# Web Push certificate key pair (Firebase console -> Project settings -> Cloud
# Messaging). Used once the staff schedule moves in here. Leaving it empty does
# NOT fail loudly: the SDK quietly falls back to a default application server
# key and still mints working tokens, so push looks fine right up until the real
# key is added and every token silently rotates. Set it before anyone enrols.
VITE_FIREBASE_VAPID_KEY=
