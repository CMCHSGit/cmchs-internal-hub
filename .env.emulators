# `npm run dev:emulators` only (Vite's "emulators" mode): the hub against the
# Firebase emulators on this computer, with made-up test staff (README, "Test
# copy"). Nothing here is secret or real: the project name starts "demo-", which
# the emulators treat as offline-only, so this can never reach the live data.
# A real build (production mode) never reads this file.
VITE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-cmchs
VITE_FIREBASE_STORAGE_BUCKET=demo-cmchs.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_AZURE_TENANT_ID=demo
