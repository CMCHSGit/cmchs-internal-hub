rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    // Signed in with a company account. Microsoft sign-in is limited to the
    // company's tenant; this is the second lock, in case a guest or another
    // account ever gets a token for this project.
    function isSignedIn()     { return request.auth != null && isCompanyEmail(); }
    function isCompanyEmail() { return request.auth.token.get('email', '').lower().matches('[^@]+@(cass|chsnz)[.]co[.]nz'); }
    function isAdmin()        { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isOwner(uid)     { return isSignedIn() && request.auth.uid == uid; }
    // HR (the hub's People page): admins, plus anyone an admin flags hr: true.
    function isHR()           { return isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('hr', false) == true); }
    // People's private records are keyed by their lower-case work email.
    function isMyEmail(email) { return isSignedIn() && email != '' && request.auth.token.get('email', '').lower() == email; }
    // Maintenance schedule: the service side of the business keeps it, so the
    // Engineers and Management teams can edit as well as admins. Everyone
    // signed in can read it — knowing what PM is due where is not sensitive,
    // and account managers need to see it without being able to change it.
    function canEditMaintenance() {
      return isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.team in ['Engineers', 'Management']
      );
    }

    // Users — all signed-in users can read the whole roster (Team view needs
    // everyone's name/team, not just their own — this was previously
    // owner-or-admin-only, which meant Team view silently broke for any
    // non-admin signed-in user; only ever worked because testing so far has
    // all been done as an admin). Create/update still owner-or-admin-only.
    // Delete additionally allows removing a "pending" placeholder record
    // (Admin's bulk-import feature) once claimed by a real sign-in — but
    // never a real (non-pending) account, which stays admin-only.
    //
    // What people may write about THEMSELVES is deliberately narrow. Until
    // 14 Oct 2026 an owner could write any field on their own record, which
    // meant anyone signed in could set role:'admin' or simproAccess:true from
    // the browser console — and admin is what the Apps Script proxy trusts for
    // Simpro writes. Every legitimate owner write is one of these three:
    //   - the profile created on first sign-in (AuthContext.jsx), always
    //     role 'user', possibly carrying a team claimed from a placeholder
    //   - choosing a team once, while it is still empty (TeamOnboarding.jsx)
    //   - registering a phone for push (push.js: fcmTokens)
    // Anything else about a person — role, simproAccess, changing a team once
    // set — is an admin's to change.
    //
    // Since the hub's People page: people may also change their own name and
    // work mobile; HR may add placeholders (with a work email), change anyone's
    // name, team, work email and work mobile, and remove anyone but an admin.
    // Only an admin can set role, simproAccess or hr.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isOwner(uid) && isNewOwnProfile()) || (isHR() && isHRNewPerson());
      allow update: if isAdmin() || (isOwner(uid) && isOwnSafeUpdate()) || (isHR() && isHRSafeUpdate());
      // A placeholder is claimed during someone's FIRST sign-in, before their
      // own record is written (AuthContext: claimPendingProfile runs before
      // setDoc). So only a person with no record yet may remove one — which
      // stops anyone already signed in from deleting other people's
      // placeholders, without copying the claim's fuzzy name matching here.
      allow delete: if isAdmin() || (isHR() && resource.data.get('role', 'user') != 'admin') || (
        isSignedIn() &&
        resource.data.pending == true &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    // A team grants rights, so nobody gives themselves one: a new profile has
    // no team, unless it claims an HR-made placeholder whose email is exactly
    // this sign-in's, and takes that placeholder's team, removing it in the
    // same write (AuthContext's claimPendingProfile).
    function isNewOwnProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'email', 'team', 'role', 'excelName', 'workMobile', 'createdAt', 'claimedFrom'])
        && d.role == 'user'
        && (d.get('team', null) in [null, ''] || isClaimedTeam(d));
    }
    function isClaimedTeam(d) {
      let from = d.get('claimedFrom', '');
      let p = /databases/$(database)/documents/users/$(from);
      return from is string && from != '' && exists(p) && !existsAfter(p)
        && get(p).data.get('pending', false) == true
        && get(p).data.get('email', '').lower() == request.auth.token.get('email', '').lower()
        && get(p).data.get('team', null) == d.team;
    }

    function isOwnSafeUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      // Not the team: only an admin or HR sets that (Settings → People and access, People).
      return changed.hasOnly(['fcmTokens', 'displayName', 'workMobile', 'notifications', 'homeLayout'])
        // Settings → Your notifications: your own reminders on or off, nothing else in there.
        && (!changed.hasAny(['notifications']) || isOwnNotifications(request.resource.data.notifications))
        // The home page's icon row: { quick: [tool ids and { label, url } links] }, at most 30.
        && (!changed.hasAny(['homeLayout']) || isHomeLayout(request.resource.data.homeLayout))
        && (!changed.hasAny(['displayName']) || isShortText(request.resource.data.displayName, 1, 80))
        && (!changed.hasAny(['workMobile']) || isShortText(request.resource.data.workMobile, 0, 40));
    }

    function isShortText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    function isHomeLayout(h) {
      return h is map && h.keys().hasOnly(['quick']) && h.get('quick', []) is list && h.get('quick', []).size() <= 30;
    }

    function isOwnNotifications(n) {
      return n is map
        && n.keys().hasOnly(['scheduleReminder', 'asksSummary', 'demoReminders'])
        && n.get('scheduleReminder', true) is bool
        && n.get('asksSummary', true) is bool
        // The demo tracker's due-soon and booking pushes (step 5D).
        && n.get('demoReminders', true) is bool;
    }

    function isHRNewPerson() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'email', 'team', 'role', 'pending', 'workMobile', 'createdAt'])
        && d.role == 'user' && d.pending == true;
    }

    function isHRSafeUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'team', 'workMobile']);
    }

    // The hub's People page (HR profiles), keyed by lower-case work email.
    // Pictures are visible to everyone signed in; personal and job details
    // only to the person and HR. The person keeps their own personal details
    // and job title; the rest of the job details are HR's.
    match /staffPhotos/{email} {
      allow read: if isSignedIn();
      allow create, update: if (isMyEmail(email) || isHR())
        && request.resource.data.keys().hasOnly(['photo', 'updatedAt'])
        && request.resource.data.photo is string
        && request.resource.data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}')
        && request.resource.data.photo.size() < 200000;
      allow delete: if isMyEmail(email) || isHR();
    }
    match /staffPrivate/{email} {
      allow read, delete: if isMyEmail(email) || isHR();
      allow create, update: if (isMyEmail(email) || isHR())
        && request.resource.data.keys().hasOnly(['dateOfBirth', 'personalEmail', 'personalPhone', 'address', 'emergency', 'updatedAt', 'updatedBy']);
    }
    match /staffEmployment/{email} {
      allow read: if isMyEmail(email) || isHR();
      allow delete: if isHR();
      allow create: if (isHR() && isEmploymentDoc()) || (isMyEmail(email) && request.resource.data.keys().hasOnly(['jobTitle', 'updatedAt']));
      allow update: if (isHR() && isEmploymentDoc()) || (isMyEmail(email) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jobTitle', 'updatedAt']));
    }
    function isEmploymentDoc() {
      return request.resource.data.keys().hasOnly(['jobTitle', 'startDate', 'employmentType', 'managerUid', 'updatedAt']);
    }

    // Locations — all signed-in users can read and add new ones (so a
    // location someone types while filling out their schedule becomes a
    // suggestion for everyone); only admins can edit or remove existing ones.
    match /locations/{locId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.active == true;
      allow update, delete: if isAdmin();
    }

    // Schedules — everyone signed in can read (Team week, Day, Leave). People
    // write their own; admins can write anyone's (filling in from Team week,
    // "Copy last week", people who haven't signed in yet). A non-admin can
    // never hand a schedule to someone else by changing its uid.
    match /schedules/{schedId} {
      allow read:  if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid) || isAdmin());
      allow delete: if isAdmin();
    }

    // Weekly on-call roster, one doc per week (id = the Monday). Everyone
    // can see it; only admins assign it.
    match /oncall/{weekStart} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // The on-call roster history (Service → On-call roster): one document per sheet of the
    // old workbook (2017 to 2026) plus the engineers list, imported by an admin.
    match /oncallHistory/{sheet} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Activity log — "who did what, when", for every tool (shared/activity.js),
    // read on Settings → Staff schedule → Activity log and copied nightly to
    // Drive. Anyone signed in can log their own action (so a non-admin saving
    // their own week or booking their own leave still gets recorded); only
    // admins can read it back. Immutable: no update or delete, not even for
    // admins — an audit trail that can be edited isn't one. The time is the
    // server's (a person can't backdate a line), the line is a short piece of
    // text and has only these fields (older copies of the apps send no `app`).
    match /activity/{entryId} {
      allow read:   if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'summary', 'app', 'at'])
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.summary.size() <= 500;
    }

    // Maintenance schedule (internal.chsnz.co.nz/maintenance/) — replaces the
    // PM tracking spreadsheet. One document per scheduled PM.
    match /maintenance/{entryId} {
      allow read:   if isSignedIn();
      allow create, update, delete: if canEditMaintenance();
    }

    // Service orders (internal.chsnz.co.nz/service-orders/) — replaces the
    // service order spreadsheet. One document per order line. Kept by the
    // same people as the maintenance schedule.
    match /serviceOrders/{orderId} {
      allow read:   if isSignedIn();
      allow create, update, delete: if canEditMaintenance();
    }

    // Checklists (internal.chsnz.co.nz/checklists/) — a list of things to check on equipment (the N1 monitor
    // software upgrade, planned maintenance, a test round), ticked off by a team. A document a list, and a
    // document a device under it, so two people ticking different devices never write the same one.
    // Seen like an ask: only by whoever made it and the people and teams it is shared with (`people`,
    // `teams`). Those people read it, tick (the `checks` map, the result 'notfound', who and when, a note:
    // nothing else about a device), add a device found on site (an id starting "found-", in their own name)
    // and remove their own again. Whoever made it (an admin, or Engineers or Management, may make one)
    // imports and refreshes the devices, changes the steps and who it is shared with, renames and deletes it.
    function canSeeChecklist(l) {
      return isSignedIn() && (l.get('createdBy', '') == request.auth.uid
        || request.auth.uid in l.get('people', [])
        || (myTeam() is string && myTeam() in l.get('teams', [])));
    }
    function ownsChecklist(l) { return isSignedIn() && l.get('createdBy', '') == request.auth.uid; }
    function checklistDoc(listId) { return get(/databases/$(database)/documents/checklists/$(listId)).data; }
    function isChecklist(d) {
      return d.get('people', []) is list && d.get('people', []).size() <= 60
        && d.get('teams', []) is list && d.get('teams', []).hasOnly(['Admin', 'Management', 'Engineers', 'Sales', 'Application'])
        && d.get('steps', []) is list && d.get('steps', []).size() <= 12;
    }
    function isChecklistTick() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['checks', 'result', 'doneBy', 'doneByName', 'doneAt', 'note', 'noteByName'])
        && request.resource.data.get('checks', {}) is map
        && request.resource.data.get('result', '') in ['', 'done', 'notfound']
        && request.resource.data.get('doneBy', '') in ['', request.auth.uid]
        && request.resource.data.get('note', '').size() <= 1000;
    }
    // A device found on site that the spreadsheet didn't list.
    function isFoundOnSite(itemId) {
      return itemId.matches('found-.*')
        && request.resource.data.get('addedOnSite', false) == true
        && request.resource.data.get('addedBy', '') == request.auth.uid
        && request.resource.data.get('checks', {}) is map
        && request.resource.data.get('result', '') in ['', 'done']
        && request.resource.data.get('doneBy', '') in ['', request.auth.uid]
        && request.resource.data.get('note', '').size() <= 1000;
    }
    match /checklists/{listId} {
      allow read: if canSeeChecklist(resource.data);
      allow create: if canEditMaintenance() && request.resource.data.get('createdBy', '') == request.auth.uid && isChecklist(request.resource.data);
      allow update: if ownsChecklist(resource.data) && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') && isChecklist(request.resource.data);
      allow delete: if ownsChecklist(resource.data);
      match /items/{itemId} {
        allow read: if canSeeChecklist(checklistDoc(listId));
        allow create: if ownsChecklist(checklistDoc(listId)) || (canSeeChecklist(checklistDoc(listId)) && isFoundOnSite(itemId));
        allow delete: if ownsChecklist(checklistDoc(listId))
          || (canSeeChecklist(checklistDoc(listId)) && resource.data.get('addedBy', '') == request.auth.uid);
        allow update: if ownsChecklist(checklistDoc(listId)) || (canSeeChecklist(checklistDoc(listId)) && isChecklistTick());
      }
    }

    // Project tracker (internal.chsnz.co.nz/projects/) — replaces the project
    // team's job register and weekly timeline sheets. Everyone signed in can
    // read; anyone with a team set (or an admin) can edit, as on the shared
    // sheets. The tracker's buttons follow the same test (store.jsx canEdit).
    function canEditProjects() {
      return isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('team', '') in ['Admin', 'Management', 'Engineers', 'Sales', 'Application']
      );
    }
    match /projectJobs/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if canEditProjects();
    }
    // Who is where each week: one record per person, job, week and activity.
    match /projectAssignments/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if canEditProjects();
    }
    match /projectSettings/{id} {
      allow read: if isSignedIn();
      allow create, update: if canEditProjects();
    }
    // Comments are signed by their author and never edited. Editors can
    // delete them (their own, or with a job that is being deleted). An admin
    // can also re-add other people's, to restore them from a backup (the
    // tracker's Settings → Backups).
    match /projectComments/{id} {
      allow read:   if isSignedIn();
      allow create: if canEditProjects() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if canEditProjects();
    }
    // A job's change history: written as yourself, never edited. Only the
    // sample jobs' history can be removed (Settings → Remove sample data). An
    // admin can re-add other people's entries when restoring a backup.
    match /projectHistory/{id} {
      allow read:   if isSignedIn();
      allow create: if canEditProjects() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if canEditProjects() && resource.data.jobId.matches('sample-.*');
    }
    // Company news (the hub's Manage → News, shown on the hub home page).
    // Anyone on a team posts, as themselves; the author, an admin or HR edits
    // and deletes. Photos sit apart so the home page only fetches the ones it
    // shows; anyone who may post may set one.
    function isEngineering() {
      return isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('team', '') == 'Engineers');
    }
    match /announcements/{id} {
      allow read:   if isSignedIn();
      allow create: if canEditProjects() && request.resource.data.authorUid == request.auth.uid && isAnnouncement();
      // The author, an admin or HR edits it; anyone signed in sets or takes
      // back their own reaction, or moves the comment count by one as they
      // add or delete a comment.
      allow update: if ((resource.data.authorUid == request.auth.uid || isAdmin() || isHR())
          && request.resource.data.authorUid == resource.data.authorUid && isAnnouncement()
          && request.resource.data.get('reactions', {}) == resource.data.get('reactions', {}))
        || (isSignedIn() && isOwnReaction())
        || (isSignedIn() && isCommentCountStep());
      allow delete: if resource.data.authorUid == request.auth.uid || isAdmin() || isHR();

      // Comments: signed by their author, who edits the text; the author, the
      // post's author, an admin or HR deletes one.
      match /comments/{cid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && exists(/databases/$(database)/documents/announcements/$(id))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'atMs'])
          && request.resource.data.uid == request.auth.uid
          && isShortText(request.resource.data.name, 0, 120)
          && isShortText(request.resource.data.text, 1, 2000)
          && request.resource.data.atMs is int;
        allow update: if isSignedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAtMs'])
          && isShortText(request.resource.data.text, 1, 2000);
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin() || isHR()
          || get(/databases/$(database)/documents/announcements/$(id)).data.authorUid == request.auth.uid);
      }
    }
    // reactions: { <uid>: 'like' | 'love' | … } — only the caller's own entry changes.
    function isOwnReaction() {
      let after = request.resource.data.get('reactions', {});
      let before = resource.data.get('reactions', {});
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && after is map && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after) || after[request.auth.uid] in ['like', 'love', 'celebrate', 'laugh', 'clap', 'wow']);
    }
    function isCommentCountStep() {
      let n = request.resource.data.get('commentCount', 0);
      let was = resource.data.get('commentCount', 0);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && n is int && n >= 0 && (n == was + 1 || n == was - 1);
    }
    function isAnnouncement() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.get('body', '') is string && d.get('body', '').size() <= 4000;
    }
    match /announcementPhotos/{id} {
      allow read: if isSignedIn();
      allow create, update: if canEditProjects()
        && request.resource.data.keys().hasOnly(['photo'])
        && request.resource.data.photo is string
        && request.resource.data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}')
        && request.resource.data.photo.size() < 600000;
      allow delete: if canEditProjects() || isHR();
    }

    // Tool requests and feedback (Manage → Tool requests / Feedback). Tool
    // requests are public so people can +1 them; feedback is seen only by
    // its author and the engineering team (Engineers, and admins). Anyone
    // adds one as themselves; anyone may add or take back their own +1; only
    // the engineering team sets the status and replies.
    match /hubRequests/{id} {
      allow read: if isSignedIn() && (resource.data.kind == 'tool' || resource.data.uid == request.auth.uid || isEngineering());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['tool', 'feedback']
        && request.resource.data.status == 'new'
        && request.resource.data.get('response', '') == ''
        && (request.resource.data.kind == 'feedback' || request.resource.data.votes == [request.auth.uid]);
      allow update: if (isEngineering() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response', 'respondedBy', 'updatedAt']))
        || (isSignedIn() && resource.data.kind == 'tool' && isOwnVoteChange());
      allow delete: if isAdmin() || (resource.data.uid == request.auth.uid && resource.data.status == 'new');
    }
    function isOwnVoteChange() {
      let before = resource.data.get('votes', []).toSet();
      let after = request.resource.data.get('votes', []).toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
    }

    // Who has the tracker open: each person writes only their own record.
    match /projectPresence/{uid} {
      allow read:  if isSignedIn();
      allow write: if isOwner(uid);
    }

    // Asks (internal.chsnz.co.nz/asks/) — quick requests between staff,
    // picked up by whoever can do them. An ask is seen only by the people
    // involved: whoever asked, the people and whole teams it was sent to,
    // whoever picked it up, was @mentioned or copied in (cc) (all named in
    // `people`). Nobody else — since 20 Oct 2026 not even admins, who used to
    // see every ask. Anyone involved may change it — pick it up, hand it back,
    // mark it done, comment — but only for themselves: taking an ask someone
    // else has is for its owner, the asker or an admin who is involved. The
    // asker (or an involved admin) deletes. askStats mirrors the counting fields with no text at all, so
    // the Company page can show everyone's load to everyone; its rule checks
    // it matches the ask exactly, so it can't be used to say anything else.
    function myTeam() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('team', ''); }
    function canSeeAsk(a) {
      return isSignedIn() && (request.auth.uid in a.people || (myTeam() is string && myTeam() in a.teams));
    }
    function isAsk(d) {
      return d.keys().hasOnly(['title', 'details', 'createdBy', 'createdByName', 'createdAtMs', 'updatedAtMs',
          'assignees', 'teams', 'cc', 'people', 'owner', 'ownerName', 'status', 'waitingOn', 'urgent', 'due',
          'doneAtMs', 'doneBy', 'photoCount', 'commentCount', 'lastCommentAtMs', 'lastCommentBy', 'event', 'checklist'])
        && isShortText(d.title, 1, 200) && isShortText(d.details, 0, 4000)
        && d.createdBy is string && d.createdAtMs is number && d.doneAtMs is number
        && d.status in ['open', 'picked', 'waiting', 'done']
        && d.assignees is list && d.assignees.size() <= 40
        && d.teams is list && d.teams.hasOnly(['Admin', 'Management', 'Engineers', 'Sales', 'Application'])
        && d.assignees.size() + d.teams.size() > 0
        // Copied in to keep in the loop: optional (older asks have none), and they can see it.
        && (!('cc' in d) || (d.cc is list && d.cc.size() <= 40 && d.cc.hasOnly(d.people)))
        && d.people is list && d.people.size() <= 60 && d.createdBy in d.people
        && d.owner is string && (d.owner == '' || d.owner in d.people)
        // Nobody has an open one; somebody has one being worked on or waiting.
        && (d.status != 'open' || d.owner == '')
        && (!(d.status in ['picked', 'waiting']) || d.owner != '')
        && isShortText(d.waitingOn, 0, 120) && d.urgent is bool
        && d.due is string && (d.due == '' || d.due.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && (d.get('event', null) == null || d.event is map)
        // A checklist attached to it (apps/checklists): its id and name, or none.
        && (d.get('checklist', null) == null || (d.checklist is map && d.checklist.keys().hasOnly(['id', 'name'])
            && d.checklist.id is string && d.checklist.id.size() > 0 && d.checklist.id.size() <= 40
            && d.checklist.name is string && d.checklist.name.size() <= 120));
    }
    function isFairOwnerChange() {
      let before = resource.data.owner;
      let after = request.resource.data.owner;
      return after == before
        || (before == '' && after == request.auth.uid)
        || before == request.auth.uid || resource.data.createdBy == request.auth.uid || isAdmin();
    }
    match /asks/{id} {
      allow read: if canSeeAsk(resource.data);
      allow create: if isSignedIn() && isAsk(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if canSeeAsk(resource.data) && isAsk(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && isFairOwnerChange();
      allow delete: if canSeeAsk(resource.data) && (resource.data.createdBy == request.auth.uid || isAdmin());

      // The conversation: signed by its author, never edited. The author, the
      // asker or an admin deletes one; an admin can re-add anyone's (restoring
      // a backup). getAfter, so a comment that @mentions someone new and the
      // ask's updated people list can be saved together.
      match /comments/{cid} {
        allow read: if canSeeAsk(get(/databases/$(database)/documents/asks/$(id)).data);
        allow create: if canSeeAsk(getAfter(/databases/$(database)/documents/asks/$(id)).data)
          && (request.resource.data.uid == request.auth.uid || isAdmin())
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'atMs', 'mentions', 'photoIds'])
          && isShortText(request.resource.data.text, 0, 4000)
          && request.resource.data.mentions is list && request.resource.data.photoIds is list && request.resource.data.photoIds.size() <= 6;
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin()
          || get(/databases/$(database)/documents/asks/$(id)).data.createdBy == request.auth.uid);
      }
      // Photos from site: one shrunk JPEG per document (apps/asks/src/photos.js).
      match /photos/{pid} {
        allow read: if canSeeAsk(get(/databases/$(database)/documents/asks/$(id)).data);
        allow create: if canSeeAsk(getAfter(/databases/$(database)/documents/asks/$(id)).data)
          && (request.resource.data.uid == request.auth.uid || isAdmin())
          && request.resource.data.keys().hasOnly(['uid', 'data', 'w', 'h', 'atMs', 'commentId'])
          && request.resource.data.data is string
          && request.resource.data.data.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}')
          && request.resource.data.data.size() < 500000;
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin()
          || get(/databases/$(database)/documents/asks/$(id)).data.createdBy == request.auth.uid);
      }
    }
    match /askStats/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data == askStatsOf(getAfter(/databases/$(database)/documents/asks/$(id)).data);
      allow delete: if isSignedIn() && !existsAfter(/databases/$(database)/documents/asks/$(id));
    }
    function askStatsOf(a) {
      return {
        'status': a.status, 'owner': a.owner, 'assignees': a.assignees, 'teams': a.teams, 'due': a.due,
        'urgent': a.urgent, 'createdBy': a.createdBy, 'createdAtMs': a.createdAtMs, 'doneAtMs': a.doneAtMs
      };
    }

    // The demo tracker (internal.chsnz.co.nz/equipment/), from step 5 of
    // INTEGRATION-PLAN.md (STEP-5-PLAN.md 5B): its data moved here from the
    // chs-equipment Realtime Database, one document per item and per loan.
    // NOT USED YET: nothing reads or writes these until the cutover.
    //
    // As in the old database, everyone on staff reads and changes it all: a
    // hub account that has finished signing in (the proxy's verifyStaff_,
    // which gave the old database pass). What the old tracker kept behind the
    // admin password is for hub admins here: deleting an item, a loan or a
    // retired item for good, and turning Simpro job creation on. History and
    // the audit log are never edited; only an admin removes history, and
    // nobody removes the audit log.
    function isStaff() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('pending', false) != true;
    }
    function isEquipmentItem(id) {
      let d = request.resource.data;
      return d.get('id', id) == id && d.CHSAssetNo is string && d.CHSAssetNo.size() > 0;
    }
    match /equipment/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isEquipmentItem(id);
      // Retiring moves an item onto the retired list in the same write.
      allow delete: if isAdmin() || (isStaff() && existsAfter(/databases/$(database)/documents/retiredEquipment/$(id)));
    }
    match /retiredEquipment/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && isEquipmentItem(id) && request.resource.data.RetiredDate is string;
      allow update: if isAdmin();
      // Restoring moves it back onto the equipment list in the same write.
      allow delete: if isAdmin() || (isStaff() && existsAfter(/databases/$(database)/documents/equipment/$(id)));
    }
    // A loan, keyed by its BatchID (or the loandoc_ key of one from before
    // BatchIDs): what loanMeta and loanDocs held, and the bookings.
    match /loans/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.status in ['active', 'scheduled', 'booked', 'closed']
        && request.resource.data.get('waitingFor', []) is list;
      allow delete: if isAdmin();

      // Test reports: the file split into chunks (a document holds at most 1 MiB).
      match /reports/{rid} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(['filename', 'mimeType', 'size', 'uploadedAt', 'uploadedBy', 'chunks'])
          && isShortText(request.resource.data.filename, 1, 300)
          && request.resource.data.size is int && request.resource.data.size <= 8 * 1024 * 1024
          && request.resource.data.chunks is int && request.resource.data.chunks > 0 && request.resource.data.chunks <= 16;
        allow delete: if isStaff();

        match /chunks/{n} {
          allow read: if isStaff();
          allow create: if isStaff()
            && existsAfter(/databases/$(database)/documents/loans/$(id)/reports/$(rid))
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is string && request.resource.data.data.size() <= 950000;
          allow delete: if isStaff();
        }
      }
    }
    match /equipmentHistory/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.action is string && request.resource.data.ts is string;
      allow delete: if isAdmin();
    }
    match /equipmentAudit/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.type is string && request.resource.data.summary is string;
    }
    match /equipmentKits/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isStaff();
    }
    // tileLocations/{tileNo}: where Tile sync last saw each demo device's Tile
    // (backend/tile-sync/tile_sync.py, written daily by a GitHub Action with the
    // hub's service account, which the rules don't hold to anything). Staff read
    // it, for an item's last seen place; nobody writes it from a browser.
    match /tileLocations/{tileNo} {
      allow read: if isStaff();
      allow write: if false;
    }
    // settings/equipmentCutover: where the tracker's data is ({ source: 'rtdb' |
    // 'firestore', readOnly, by, at }; apps/equipment/src/db.js). Staff read it;
    // an admin moves it (Manage, Data source).
    match /settings/equipmentCutover {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.source in ['rtdb', 'firestore'] && request.resource.data.readOnly is bool;
    }
    // settings/equipment: simproConfig and the added demo types. Anyone turns
    // Simpro job creation off; only an admin turns it on.
    match /settings/equipment {
      allow read: if isStaff();
      allow create, update: if isStaff() && (isAdmin() || !turnsJobsOn());
    }
    function turnsJobsOn() {
      let was = resource == null ? false : resource.data.get('simproConfig', {}).get('createJobs', false);
      return request.resource.data.get('simproConfig', {}).get('createJobs', false) == true && was != true;
    }
  }
}
