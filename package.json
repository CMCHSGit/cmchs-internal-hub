{
  "name": "cmchs-internal-hub",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/hub",
    "apps/schedule",
    "apps/simprosync",
    "apps/ansurtopdf",
    "apps/maintenance",
    "apps/service-orders",
    "apps/admin",
    "apps/projects",
    "apps/asks",
    "apps/equipment",
    "apps/pdf-editor"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/hub",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --outDir dist --port 4173",
    "emulators": "node scripts/emulators.mjs",
    "emulators:seed": "node scripts/emulator-seed.mjs",
    "dev:emulators": "npm run dev -w apps/hub -- --mode emulators"
  },
  "devDependencies": {
    "vite": "^5.2.0",
    "workbox-build": "^7.1.0"
  }
}
